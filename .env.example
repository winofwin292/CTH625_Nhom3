# Copy thành .env (không commit file .env).
# Token: fine-grained + quyền "Make calls to Inference Providers"
#   https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
# Bật Featherless AI (Routed by HF): https://huggingface.co/settings/inference-providers

HF_TOKEN=
HF_PROVIDER=featherless-ai
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ChromaDB (không tải MiniLM; embedding hash nội bộ)
CHROMA_PATH=data/chroma
